            va="center",
            fontsize=10.0,
            fontweight="bold",
            color="#1e293b",
            bbox=dict(
                boxstyle="round,pad=0.25",
                facecolor="#ffffff",
                edgecolor="#cbd5e1",
                lw=1.0,
