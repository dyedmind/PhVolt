):
    print(f"\n[INFO] Gerando Rate Capability com o arquivo: {caminho_arquivo}")
    caminho_arquivo = Path(caminho_arquivo)
    if not caminho_arquivo.exists():
        raise FileNotFoundError(f"Arquivo '{caminho_arquivo}' não encontrado.")

    with open(caminho_arquivo, "r", encoding="utf-8", errors="ignore") as f:
        linhas = [linha.strip() for linha in f if linha.strip()]

    idx_primeiro_dado = 0
    idx_long_name, idx_comments = None, None

    for i, linha in enumerate(linhas):
        partes = linha.split()
        if not partes:
            continue
        if "Long Name" in linha or "LongName" in linha:
            idx_long_name = i
        elif "Comments" in linha or "Comment" in linha:
            idx_comments = i

        conseguiu_converter = False
        for p in partes:
            try:
                float(p.replace(",", "."))
                conseguiu_converter = True
                break
            except ValueError:
                continue

        if conseguiu_converter and not any(tag in linha for tag in ["Long Name", "Comments", "Units", "Axis"]):
            idx_primeiro_dado = i
            break

    idx_rotulos = (
        idx_long_name
        if idx_long_name is not None
        else (idx_comments if idx_comments is not None else max(0, idx_primeiro_dado - 1))
    )

    linha_cabecalho = linhas[idx_rotulos]
    tokens = [t.strip() for t in linha_cabecalho.split("\t") if t.strip()]
    if len(tokens) <= 1:
        tokens = [t.strip() for t in linha_cabecalho.split() if t.strip()]

    descartes = ["LONG NAME", "LONGNAME", "COMMENTS", "COMMENT", "UNITS", "UNIT", "AXIS"]
    tokens_limpos = [t for t in tokens if not any(p == t.upper() for p in descartes)]

    df = ler_tabela_origin_segura(caminho_arquivo, skiprows=idx_primeiro_dado).dropna(how="all")

    x_ciclos = df.iloc[:, 0].to_numpy(dtype=float)
    num_curvas = df.shape[1] - 1

    legendas = tokens_limpos[1:] if len(tokens_limpos) > num_curvas else tokens_limpos
    if len(legendas) < num_curvas:
        legendas = [f"Sample {i+1}" for i in range(num_curvas)]

    if zonas_c_rate is None:
        zonas_c_rate = [
            {"label": "0.1 C", "start": 0.5, "end": 5.5, "mid": 3.0},
