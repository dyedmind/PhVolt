# ------------------------------------------------------------------------------
def plotar_isotermas_bet(
    caminho_arquivo="dados_bet.txt",
    nome_saida="bet_isotherms_universal",
    areas_bet=None,
    exibir_inset=False,
    salvar_svg=False,
    paleta=None,
):
    print(f"\n[INFO] Gerando Isotermas BET com o arquivo: {caminho_arquivo}")
    caminho_arquivo = Path(caminho_arquivo)
    if not caminho_arquivo.exists():
        raise FileNotFoundError(f"Arquivo '{caminho_arquivo}' não encontrado.")

    with open(caminho_arquivo, "r", encoding="utf-8", errors="ignore") as f:
        linhas = [linha.rstrip("\r\n") for linha in f if linha.strip()]

    idx_primeiro_dado = 0
    idx_long_name, idx_comments = None, None

    for i, linha in enumerate(linhas):
        partes = linha.split()
        if not partes:
            continue
        if "Long Name" in linha or "LongName" in linha:
            idx_long_name = i
        elif "Comments" in linha or "Comment" in linha:
            idx_comments = i

        conseguiu_converter = False
        for p in partes:
            try:
                float(p.replace(",", "."))
                conseguiu_converter = True
                break
            except ValueError:
                continue

        if conseguiu_converter and not any(
            tag in linha
            for tag in ["Long Name", "Comments", "Units", "Axis", r"\-(", r"\+("]
        ):
            idx_primeiro_dado = i
            break

    idx_rotulos = (
        idx_long_name
        if idx_long_name is not None
        else (idx_comments if idx_comments is not None else 0)
    )

    linha_cabecalho = linhas[idx_rotulos]
    if "\t" in linha_cabecalho:
        tokens = [t.strip() for t in linha_cabecalho.split("\t")]
    else:
        tokens = [t.strip() for t in linha_cabecalho.split()]

    descartes = [
        "LONG NAME",
        "LONGNAME",
        "COMMENTS",
        "COMMENT",
        "UNITS",
        "UNIT",
        "AXIS",
        "",
    ]
    tokens_limpos = [
        t for t in tokens if not any(p == t.upper() for p in descartes)
    ]

    nomes_detectados = []
    if len(tokens_limpos) >= 2:
        for k in range(1, len(tokens_limpos), 2):
            nomes_detectados.append(tokens_limpos[k])
    else:
        nomes_detectados = tokens_limpos

    num_amostras = max(1, len(nomes_detectados))
    num_cols = num_amostras * 2

    matriz_dados = []
    for linha in linhas[idx_primeiro_dado:]:
        if "\t" in linha:
            partes = linha.split("\t")
        else:
            partes = linha.split()

        linha_num = []
        for p in partes:
            p_limpo = p.strip().replace(",", ".")
            try:
                linha_num.append(float(p_limpo))
            except ValueError:
                linha_num.append(np.nan)

        while len(linha_num) < num_cols:
            linha_num.append(np.nan)
        matriz_dados.append(linha_num[:num_cols])

    df = pd.DataFrame(matriz_dados)

    isotherms = []

    for idx_amostra in range(num_amostras):
        col_x = idx_amostra * 2
        col_y = col_x + 1

        if col_y >= df.shape[1]:
            break

        nome = (
            nomes_detectados[idx_amostra]
            if idx_amostra < len(nomes_detectados)
            else f"Sample {idx_amostra + 1}"
        )

        subset = df.iloc[:, [col_x, col_y]].dropna()
        if len(subset) == 0:
            continue

        p_p0 = subset.iloc[:, 0].to_numpy(dtype=float)
        v_ads = subset.iloc[:, 1].to_numpy(dtype=float)

        idx_pico = int(np.argmax(p_p0)) if len(p_p0) > 0 else 0
        tem_dessorcao = (idx_pico < (len(p_p0) - 2)) and (
            p_p0[-1] < p_p0[idx_pico]
        )

        isotherms.append(
            {
                "name": nome,
                "ads_p": p_p0[: idx_pico + 1],
                "ads_v": v_ads[: idx_pico + 1],
                "des_p": p_p0[idx_pico:] if tem_dessorcao else np.array([]),
                "des_v": v_ads[idx_pico:] if tem_dessorcao else np.array([]),
                "tem_dessorcao": tem_dessorcao,
                "v_max": np.max(v_ads) if len(v_ads) > 0 else 0,
            }
        )

    if not isotherms:
        raise ValueError(
            "Nenhum dado numérico válido de BET pôde ser extraído do arquivo."
        )

    fig, ax = plt.subplots(figsize=(8.8, 5.4), dpi=300)
    cores_ciclo = cycle(paleta if paleta else PALETA_CORES)
    legend_elements = []

    todos_v_max = [iso["v_max"] for iso in isotherms if iso["v_max"] > 0]
    v_max = max(todos_v_max) if todos_v_max else 1000

    for iso in isotherms:
        cor = next(cores_ciclo)
        nome = iso["name"]

        val_bet = (
            areas_bet.get(nome, areas_bet.get(nome.replace(" ", ""), None))
            if areas_bet
            else None
        )
        rotulo = (
            rf"{nome}  $\mathbf{{({val_bet:.0f}\ m^2\ g^{{-1}})}}$"
            if val_bet
            else nome
        )

        # 1. Ramo de Adsorção estrito
        ax.plot(
            iso["ads_p"],
            iso["ads_v"],
            color=cor,
            linewidth=1.7,
            alpha=0.85,
            zorder=3,
        )
        ax.scatter(
            iso["ads_p"],
            iso["ads_v"],
            color=cor,
            s=28,
            marker="o",
            edgecolors="white",
            linewidths=0.6,
            zorder=4,
        )

        # 2. Ramo de Dessorção estrito
        if iso["tem_dessorcao"] and len(iso["des_p"]) > 0:
            ax.plot(
                iso["des_p"],
                iso["des_v"],
                color=cor,
                linewidth=1.7,
                alpha=0.85,
                zorder=3,
            )
            ax.scatter(
                iso["des_p"],
                iso["des_v"],
                facecolors="white",
                edgecolors=cor,
                s=28,
                marker="o",
                linewidths=1.2,
                zorder=5,
            )

        legend_elements.append(
            Line2D(
                [0],
                [0],
                marker="o",
                color="none",
                markeredgecolor="white",
                markerfacecolor=cor,
                markersize=7,
                label=rotulo,
            )
        )

    if exibir_inset and len(isotherms) > 1:
        amostras_baixas = [
            iso for iso in isotherms if iso["v_max"] < (v_max * 0.25)
        ]
        if amostras_baixas:
            ax_ins = inset_axes(
                ax,
                width="100%",
                height="100%",
                bbox_to_anchor=(0.54, 0.22, 0.38, 0.28),
                bbox_transform=ax.transAxes,
            )
            ax_ins.set_facecolor("white")
            cores_inset = cycle(paleta if paleta else PALETA_CORES)

            for iso in isotherms:
                cor_ins = next(cores_inset)
                if iso in amostras_baixas:
                    ax_ins.plot(
                        iso["ads_p"],
                        iso["ads_v"],
                        color=cor_ins,
                        linewidth=1.4,
                        alpha=0.9,
                        zorder=3,
                    )
                    ax_ins.scatter(
                        iso["ads_p"],
                        iso["ads_v"],
                        color=cor_ins,
                        s=18,
                        marker="o",
                        edgecolors="white",
                        linewidths=0.4,
                        zorder=4,
                    )
                    if iso["tem_dessorcao"] and len(iso["des_p"]) > 0:
                        ax_ins.plot(
                            iso["des_p"],
                            iso["des_v"],
                            color=cor_ins,
                            linewidth=1.4,
                            alpha=0.9,
                            zorder=3,
                        )
                        ax_ins.scatter(
                            iso["des_p"],
                            iso["des_v"],
                            facecolors="white",
                            edgecolors=cor_ins,
                            s=18,
                            marker="o",
                            linewidths=0.9,
                            zorder=5,
                        )

            ax_ins.set_xlim(-0.02, 1.02)
            ax_ins.set_xticks([0.0, 0.5, 1.0])
            ax_ins.tick_params(labelsize=8.5, length=3, width=1.0)
            for spine in ["top", "right", "bottom", "left"]:
                ax_ins.spines[spine].set_color("#64748b")
                ax_ins.spines[spine].set_linewidth(1.0)
            ax_ins.grid(True, linestyle=":", alpha=0.4, color="#cbd5e1")
            ax_ins.set_title(
                "Low-pore volume region",
                fontsize=8.5,
                fontweight="bold",
                color="#475569",
                pad=3,
            )

    ax.set_xlabel(
        r"$\mathbf{Relative\ Pressure\ (p/p_0)}$", fontsize=12.5, labelpad=8
    )
    ax.set_ylabel(
        r"$\mathbf{Quantity\ Adsorbed\ (cm^3\ g^{-1}\ STP)}$",
        fontsize=12.5,
        labelpad=8,
    )
    ax.set_xlim(-0.02, 1.02)
    ax.set_ylim(-20, v_max * 1.18)
    ax.tick_params(direction="out", length=5, width=1.4, labelsize=10.5)

    for spine in ["top", "right", "bottom", "left"]:
        ax.spines[spine].set_visible(True)
        ax.spines[spine].set_color("#334155")
        ax.spines[spine].set_linewidth(1.4)

    ax.grid(True, linestyle=":", alpha=0.4, color="#cbd5e1")
    ax.set_axisbelow(True)

    leg_amostras = ax.legend(
        handles=legend_elements,
        title=r"$\mathbf{Sample\ (S_{BET})}$" if areas_bet else r"$\mathbf{Sample}$",
        title_fontsize=10.5,
        frameon=True,
        facecolor="white",
        framealpha=0.96,
        edgecolor="#cbd5e1",
        fontsize=9.5,
        loc="upper left",
        bbox_to_anchor=(0.03, 0.98),
        labelspacing=0.45,
    )
    ax.add_artist(leg_amostras)

    elementos_tipo = [
        Line2D(
            [0],
            [0],
            marker="o",
            color="none",
            markeredgecolor="white",
            markerfacecolor="#475569",
            markersize=6.5,
            label="Adsorption (closed)",
        ),
        Line2D(
            [0],
            [0],
            marker="o",
            color="none",
            markeredgecolor="#475569",
            markerfacecolor="white",
            markeredgewidth=1.2,
            markersize=6.5,
            label="Desorption (open)",
        ),
    ]

    ax.legend(
        handles=elementos_tipo,
        frameon=True,
        facecolor="white",
        framealpha=0.96,
        edgecolor="#cbd5e1",
        fontsize=9.0,
        loc="lower right",
        bbox_to_anchor=(0.97, 0.08),
        labelspacing=0.35,
    )

    plt.tight_layout()
    salvar_figura_com_timestamp(nome_saida, salvar_svg=salvar_svg)


