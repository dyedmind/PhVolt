def plotar_ciclabilidade(
    caminho_arquivo="dados_ciclabilidade.txt",
    nome_saida="ciclabilidade_universal",
    eixo_x_label=r"$\mathbf{Cycle\ Number}$",
    eixo_y_label=r"$\mathbf{Specific\ Capacity\ (mAh\ g_S^{-1})}$",
    unidade_y=r"mAh\ g^{-1}",
    rate_tag="Rate: 0.5 C",
    salvar_svg=False,
    paleta=None,
):
    print(f"\n[INFO] Gerando Ciclabilidade com o arquivo: {caminho_arquivo}")
    caminho_arquivo = Path(caminho_arquivo)
    if not caminho_arquivo.exists():
        raise FileNotFoundError(f"Ficheiro '{caminho_arquivo}' não encontrado.")

    with open(caminho_arquivo, "r", encoding="utf-8", errors="ignore") as f:
        linhas = [l.strip() for l in f if l.strip()]

    idx_primeiro_dado = 0
    idx_long_name, idx_comments = None, None

    for i, linha in enumerate(linhas):
        partes = linha.split()
        if not partes:
            continue
        if "Long Name" in linha or "LongName" in linha:
            idx_long_name = i
        elif "Comments" in linha or "Comment" in linha:
            idx_comments = i

        conseguiu_converter = False
        for p in partes:
            try:
                float(p.replace(",", "."))
                conseguiu_converter = True
                break
            except ValueError:
                continue

        if conseguiu_converter and not any(tag in linha for tag in ["Long Name", "Comments", "Units", "Axis"]):
            idx_primeiro_dado = i
            break

    idx_rotulos = (
        idx_long_name
        if idx_long_name is not None
        else (idx_comments if idx_comments is not None else max(0, idx_primeiro_dado - 1))
    )

    linha_cabecalho = linhas[idx_rotulos]
    tokens = [t.strip() for t in linha_cabecalho.split("\t") if t.strip()]
    if len(tokens) <= 1:
        tokens = [t.strip() for t in linha_cabecalho.split() if t.strip()]

    descartes = ["LONG NAME", "LONGNAME", "COMMENTS", "COMMENT", "UNITS", "UNIT", "AXIS"]
    tokens_limpos = [t for t in tokens if not any(p == t.upper() for p in descartes)]

    df = ler_tabela_origin_segura(caminho_arquivo, skiprows=idx_primeiro_dado)

    curvas = []
    num_cols = df.shape[1]

    if num_cols >= 2 and num_cols % 2 == 0:
        nomes_y = []
        if len(tokens_limpos) >= 2:
            for k in range(1, len(tokens_limpos), 2):
                nomes_y.append(tokens_limpos[k])
        else:
            nomes_y = tokens_limpos

        for idx_amostra, col in enumerate(range(0, num_cols, 2)):
            subset = df.iloc[:, [col, col + 1]].dropna().reset_index(drop=True)
            if len(subset) == 0:
                continue
            nome = nomes_y[idx_amostra] if idx_amostra < len(nomes_y) else f"Sample {idx_amostra + 1}"
            curvas.append(
                {
                    "nome": nome,
                    "x": subset.iloc[:, 0].to_numpy(dtype=float),
                    "y": subset.iloc[:, 1].to_numpy(dtype=float),
                }
            )
    else:
        nomes_y = tokens_limpos[1:] if len(tokens_limpos) >= num_cols else tokens_limpos
        for col in range(1, num_cols):
            subset = df.iloc[:, [0, col]].dropna().reset_index(drop=True)
            if len(subset) == 0:
                continue
            idx_nome = col - 1
            nome = nomes_y[idx_nome] if idx_nome < len(nomes_y) else f"Sample {col}"
            curvas.append(
                {
                    "nome": nome,
                    "x": subset.iloc[:, 0].to_numpy(dtype=float),
                    "y": subset.iloc[:, 1].to_numpy(dtype=float),
                }
            )

    if not curvas:
        raise ValueError("Nenhum dado numérico pôde ser extraído do arquivo.")

    fig, ax = plt.subplots(figsize=(9.2, 5.2), dpi=300)
    cores_ciclo = cycle(paleta if paleta else PALETA_CORES)

    todos_x = np.concatenate([c["x"] for c in curvas if len(c["x"]) > 0])
    todos_y = np.concatenate([c["y"] for c in curvas if len(c["y"]) > 0])
    x_min, x_max = np.min(todos_x), np.max(todos_x)
    y_min, y_max = np.min(todos_y), np.max(todos_y)

    dados_finais = []

    for c in curvas:
        if len(c["x"]) == 0:
            continue
        nome = c["nome"]
        cor = next(cores_ciclo)

        ax.plot(
            c["x"],
            c["y"],
            color=cor,
            linestyle="-",
            linewidth=2.0,
            label=nome,
            zorder=4,
        )

        c0_val = c["y"][0]
        c_final_val = c["y"][-1]
        retencao = (c_final_val / c0_val) * 100 if c0_val != 0 else 0.0

        dados_finais.append(
            {
                "nome": nome,
                "x_end": c["x"][-1],
                "y_end": c_final_val,
                "retencao": retencao,
                "cor": cor,
            }
        )

        ax.scatter(
            c["x"][-1],
            c_final_val,
            color=cor,
            s=30,
            zorder=6,
            edgecolors="white",
            linewidths=0.8,
        )

    dados_finais.sort(key=lambda item: item["y_end"], reverse=True)
    num_amostras = len(dados_finais)

    span_x = x_max - x_min
    x_pos_caixas = x_max + span_x * 0.045
    x_lim_max = x_max + span_x * 0.32

    span_y = y_max - (y_min if y_min < 0 else 0)
    topo_caixas = span_y * 0.32
    base_caixas = span_y * 0.06
    y_posicoes = (
        np.linspace(topo_caixas, base_caixas, num_amostras)
        if num_amostras > 1
        else [topo_caixas]
    )

    for i, d in enumerate(dados_finais):
        y_ancora = y_posicoes[i]
        ax.annotate(
            rf"$\mathbf{{{d['y_end']:.0f}\ {unidade_y}}}$  ({d['retencao']:.1f}%)",
            xy=(d["x_end"], d["y_end"]),
            xytext=(x_pos_caixas, y_ancora),
            fontsize=8.5,
            fontweight="semibold",
            color="#1e293b",
            va="center",
            bbox=dict(
                boxstyle="round,pad=0.36",
                facecolor="#ffffff",
                edgecolor=d["cor"],
                linewidth=1.3,
                alpha=0.98,
            ),
            arrowprops=dict(
                arrowstyle="->",
                color=d["cor"],
                lw=1.0,
                connectionstyle="arc3,rad=-0.08",
            ),
            zorder=7,
        )

    ax.axvline(x_max, color="#94a3b8", linestyle=":", linewidth=1.1, alpha=0.8, zorder=2)

    if rate_tag:
        ax.text(
            0.04,
            0.93,
            rf"$\mathbf{{{rate_tag}}}$",
            transform=ax.transAxes,
            fontsize=10.5,
            fontweight="bold",
            color="#334155",
            bbox=dict(
                boxstyle="round,pad=0.4",
                facecolor="white",
                edgecolor="#cbd5e1",
                linewidth=1.1,
                alpha=0.95,
            ),
            zorder=6,
        )

    ax.set_xlabel(eixo_x_label, fontsize=12.5, labelpad=8)
    ax.set_ylabel(eixo_y_label, fontsize=12.5, labelpad=8)
    ax.set_xlim(x_min - span_x * 0.02, x_lim_max)
    ax.set_ylim(min(-span_y * 0.02, y_min), y_max * 1.15)
    ax.tick_params(direction="out", length=5, width=1.4, labelsize=10.5)

    for spine in ["top", "right", "bottom", "left"]:
        ax.spines[spine].set_visible(True)
        ax.spines[spine].set_color("#334155")
        ax.spines[spine].set_linewidth(1.4)

    ax.grid(True, linestyle=":", alpha=0.4, color="#cbd5e1")
    ax.set_axisbelow(True)

    ax.legend(
        frameon=True,
        facecolor="white",
        framealpha=0.96,
        edgecolor="#cbd5e1",
        fontsize=10,
        loc="upper right",
        bbox_to_anchor=(0.98, 0.98),
    )

    plt.tight_layout()
    salvar_figura_com_timestamp(nome_saida, salvar_svg=salvar_svg)


