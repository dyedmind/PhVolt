def buscar_arquivo_dados(pasta_base, padrao_nome, arquivo_padrao):
    """Busca estritamente arquivos de dados (.txt, .dat, .csv), ignorando saídas de imagem."""
    extensoes_dados = {".txt", ".dat", ".csv"}
    candidatos = [
        f
        for f in pasta_base.glob(f"*{padrao_nome}*")
        if f.is_file() and f.suffix.lower() in extensoes_dados
    ]
    if candidatos:
        return candidatos[0]
    return pasta_base / arquivo_padrao


def ler_tabela_origin_segura(caminho_arquivo, skiprows=0):
    """Lê arquivos .txt/.dat respeitando estritamente colunas vazias sem misturar amostras."""
    with open(caminho_arquivo, "r", encoding="utf-8", errors="ignore") as f:
        linhas = [l.rstrip("\r\n") for l in f]

    matriz = []
    max_cols = 0

    for l in linhas[skiprows:]:
        if not l.strip():
            continue
        if "\t" in l:
            partes = l.split("\t")
        else:
            partes = l.split()

        max_cols = max(max_cols, len(partes))

        linha_num = []
        for p in partes:
            p_limpo = p.strip().replace(",", ".")
            try:
                linha_num.append(float(p_limpo))
            except ValueError:
                linha_num.append(np.nan)
        matriz.append(linha_num)

    for row in matriz:
        while len(row) < max_cols:
            row.append(np.nan)

    return pd.DataFrame(matriz)


def salvar_figura_com_timestamp(nome_base, salvar_svg=False):
    """Salva a figura com carimbo de data e hora (YYYYMMDD_HHMMSS) para não sobrescrever."""
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    nome_final = f"{nome_base}_{timestamp}"

    caminho_png = Path(f"{nome_final}.png")
    caminho_svg = Path(f"{nome_final}.svg")

    # Salva sempre em PNG
    plt.savefig(caminho_png, dpi=300, bbox_inches="tight")
    print(f"\n[OK] Gráfico salvo com sucesso: {caminho_png.name}")

    # Salva em SVG somente se solicitado
    if salvar_svg:
        plt.savefig(caminho_svg, format="svg", bbox_inches="tight")
        print(f"[OK] Gráfico vetorial salvo: {caminho_svg.name}")

    plt.show()
    plt.close("all")


